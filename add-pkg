#!/usr/bin/env bash
set -euo pipefail

readonly ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PKG_ROOT="$ROOT/pkg"

main() {
    if (( $# < 1 || $# > 2 )); then
        printf 'Usage: %s <executable> [package-name]\n' "${0##*/}" >&2
        exit 2
    fi

    local source=$1 package=${2:-}
    validate_source "$source"
    package=$(resolve_package "$package")
    validate_package "$package"
    stage_executable "$source" "$package"
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

validate_source() {
    [[ -f $1 && -r $1 ]] || fail "Source is not a readable regular file: $1"
    [[ -x $1 ]] || fail "Source is not executable: $1"
    [[ ${1##*/} != *$'\n'* ]] || fail 'Executable name cannot contain newlines'
}

resolve_package() {
    local requested=$1
    if [[ -n $requested ]]; then
        printf '%s\n' "$requested"
        return
    fi

    [[ -d $PKG_ROOT ]] || fail "Package directory does not exist: $PKG_ROOT"
    local -a candidates=()
    local dir
    for dir in "$PKG_ROOT"/*; do
        [[ -f $dir/DEBIAN/control ]] && candidates+=("${dir##*/}")
    done

    case ${#candidates[@]} in
        0) fail 'No existing packages found; create one with new-pkg first' ;;
        1) printf '%s\n' "${candidates[0]}" ;;
        *)
            [[ -t 0 ]] || fail 'Multiple packages exist; specify a package name'
            printf 'Available packages:\n' >&2
            printf '  %s\n' "${candidates[@]}" >&2
            printf 'Package name: ' >&2
            local selection
            IFS= read -r selection || fail 'No package selected'
            printf '%s\n' "$selection"
            ;;
    esac
}

validate_package() {
    [[ $1 =~ ^[a-z0-9][a-z0-9+.-]*$ ]] || fail "Invalid package directory name: $1"
    [[ -d $PKG_ROOT/$1 ]] || fail "Package does not exist: $1"
    [[ -f $PKG_ROOT/$1/DEBIAN/control ]] || fail "Missing DEBIAN/control for: $1"
    [[ -d $PKG_ROOT/$1/bin ]] || fail "Missing bin/ in package: $1"
}

stage_executable() {
    local source=$1 package=$2
    local destination="$PKG_ROOT/$package/bin/${source##*/}"

    [[ ! -L $destination ]] || fail "Destination is a symlink: $destination"
    if [[ -e $destination ]]; then
        [[ -f $destination ]] || fail "Destination is not a regular file: $destination"
        if cmp -s -- "$source" "$destination"; then
            printf 'Already staged (identical): %s\n' "$destination"
            return
        fi
        [[ -t 0 ]] || fail "Destination exists; run interactively to confirm replacement: $destination"
        printf 'Replace existing %s? [y/N] ' "$destination" >&2
        local answer
        IFS= read -r answer || fail 'Replacement cancelled'
        [[ $answer == y || $answer == Y ]] || fail 'Replacement cancelled'
    fi

    install -m 755 -- "$source" "$destination"
    printf 'Staged: %s -> %s\n' "$source" "$destination"
}

main "$@"
