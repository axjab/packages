#!/usr/bin/env bash
set -euo pipefail

main() {
    upload_packages
    update_repository
    sign_repository
    announce_publication
}

upload_packages() {
    rsync -Pvr dist/*.deb publish:public/apt/pool/main/
}

update_repository() {
    ssh publish 'bash -se' <<'REMOTE'
set -euo pipefail
cd ~/public/apt

update_package_index() {
    mkdir -p dists/trixie/main/binary-amd64

    dpkg-scanpackages pool/main \
        > dists/trixie/main/binary-amd64/Packages

    gzip -n -9 -c dists/trixie/main/binary-amd64/Packages \
        > dists/trixie/main/binary-amd64/Packages.gz
}

update_release_metadata() {
    apt-ftparchive \
        -o APT::FTPArchive::Release::Origin=ALJ \
        -o APT::FTPArchive::Release::Label=ALJ \
        -o APT::FTPArchive::Release::Suite=trixie \
        -o APT::FTPArchive::Release::Codename=trixie \
        -o APT::FTPArchive::Release::Architectures=amd64 \
        -o APT::FTPArchive::Release::Components=main \
        release dists/trixie > dists/trixie/Release
}

update_package_index
update_release_metadata
REMOTE
}

sign_repository() {
    ssh -tt publish '
        set -e
        cd ~/public/apt
        export GPG_TTY=$(tty)

        gpg-connect-agent updatestartuptty /bye >/dev/null

        gpg --yes \
            --local-user "ALJ APT Repository" \
            --clearsign \
            --output dists/trixie/InRelease \
            dists/trixie/Release
    '
}

announce_publication() {
    echo
    echo "Published to https://fs.alj.cx/apt/"
}

main "$@"
