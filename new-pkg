#!/usr/bin/env bash
set -euo pipefail

readonly PKG_ROOT="pkg"
readonly INITIAL_VERSION="0.0.0"

main() {
    local name="${1:-}"

    if (( $# > 1 )); then
        usage >&2
        exit 2
    fi

    if [[ -z "$name" ]]; then
        read -r -p 'Package name: ' name
    fi

    validate_name "$name"
    create_skeleton "$name"
    printf 'Created %s/%s/\n' "$PKG_ROOT" "$name"
    printf 'Edit %s/%s/DEBIAN/control before building.\n' "$PKG_ROOT" "$name"
}

usage() {
    printf 'Usage: %s [package-name]\n' "${0##*/}"
}

validate_name() {
    local name="$1"

    # Debian binary package names: lowercase letters, digits, +, -, and .;
    # at least two characters, starting with an alphanumeric character.
    if [[ ! "$name" =~ ^[a-z0-9][a-z0-9+.-]+$ ]]; then
        printf 'Invalid Debian package name: %s\n' "$name" >&2
        exit 2
    fi

    if [[ -e "$PKG_ROOT/$name" ]]; then
        printf 'Package directory already exists: %s/%s\n' "$PKG_ROOT" "$name" >&2
        exit 1
    fi
}

create_skeleton() {
    local name="$1"
    local target="$PKG_ROOT/$name"

    mkdir -p "$target/bin" "$target/DEBIAN"
    cat > "$target/DEBIAN/control" <<CONTROL
Package: $name
Version: $INITIAL_VERSION
Section: utils
Priority: optional
Architecture: all
Maintainer: TODO <maintainer@example.invalid>
Description: TODO short description
 TODO longer description (replace or remove this line).
CONTROL
}

main "$@"
