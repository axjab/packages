#!/usr/bin/env bash
set -euo pipefail

readonly REMOTE="publish"
readonly REMOTE_POOL="public/apt/pool/main"

main() {
    local pkg="${1:?Usage: ./pkg-publish <package-name>}"
    local source="pkg/$pkg/DEBIAN/control"

    [[ -f "$source" ]] || {
        echo "Error: Package '$pkg' does not exist." >&2
        exit 1
    }

    local name version arch artifact
    name=$(dpkg-deb --field "dist/"*.deb Package 2>/dev/null) # Not used; see below
}
